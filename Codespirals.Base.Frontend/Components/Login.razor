@using Microsoft.AspNetCore.Components.Forms

<EditForm>
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="form-group">
        <label for="usernameOrEmail">@ComponentText.UsernameOrEmail</label>
        <InputText id="usernameOrEmail" class="form-control" @bind="Data.UserNameOrEmail" />
    </div>

    <div class="form-group">
        <label for="password">@ComponentText.Password</label>
        <InputText id="password" type="password" class="form-control" @bind="Data.Password" />
    </div>

    <div class="form-group form-check">
        <InputCheckbox id="stayLoggedIn" class="form-check-input" @bind-Value="Data.StayLoggedIn"/>
        <label class="form-check-label" for="stayLoggedIn">@ComponentText.StayLoggedIn</label>
    </div>

    <button type="submit" class="btn btn-primary">@ComponentText.Login</button>

</EditForm>

@code
{
    [Parameter]
    public required ILoginBase Data { get; set; }
}