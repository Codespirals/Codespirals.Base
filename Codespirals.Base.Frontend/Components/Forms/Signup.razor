@namespace Codespirals.Base.Components.Forms
@using Microsoft.AspNetCore.Components.Forms

<EditForm>
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="form-group">
        <label for="email">@ComponentText.Email</label>
        <InputText id="email" class="form-control" @bind="Data.Email" />
    </div>

    <div class="form-group">
        <label for="username">@ComponentText.Username</label>
        <InputText id="username" class="form-control" @bind="Data.UserName" />
    </div>

    <div class="form-group">
        <label for="password">@ComponentText.Password</label>
        <InputText id="password" type="password" class="form-control" @bind="Data.Password" />
    </div>

    <button type="submit" class="btn btn-primary">@ComponentText.Signup</button>
</EditForm>

@code
{
    [Parameter]
    public required ISignupBase Data { get; set; }
}