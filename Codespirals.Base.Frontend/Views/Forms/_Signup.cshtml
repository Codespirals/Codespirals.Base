@model ISignupBase
<form>
    <div class="form-group">
        <label for="email">@ComponentText.Email</label>
        <input id="email" class="form-control" value="@Model.Email" />
    </div>

    <div class="form-group">
        <label for="username">@ComponentText.Username</label>
        <input id="username" class="form-control" value="@Model.UserName" />
    </div>

    <div class="form-group">
        <label for="password">@ComponentText.Password</label>
        <input id="password" type="password" class="form-control" value="@Model.Password" />
    </div>

    <div class="form-group">
        <label for="password_verify">@ComponentText.Password</label>
        <input id="password_verify" type="password" class="form-control"  />
    </div>

    <button type="submit" class="btn btn-primary">@ComponentText.Signup</button>
</form>